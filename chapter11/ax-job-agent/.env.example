# 이 파일을 복사해서 .env를 만들고, 실제 값은 .env에만 넣는다 (.env는 git에 올라가지 않음).
# Gemini API 키: https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=

# Gmail 발송용 (STEP 13): 보내는 Gmail 주소와 앱 비밀번호
# 앱 비밀번호는 Google 계정 2단계 인증을 켠 뒤 https://myaccount.google.com/apppasswords 에서 발급 (일반 비밀번호 아님)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Slack 발송용 (STEP 12): Incoming Webhook URL (URL 자체가 비밀값이다)
# 발급: Slack 앱 설정 > Incoming Webhooks > 채널 선택 후 Webhook URL 복사
SLACK_PROD_WEBHOOK_URL=
